{
  "name": "department-os",
  "version": "0.0.0",
  "private": true,
  "description": "Department OS Core — Problem Department MVP implementation",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/web/server.ts",
    "start": "node --import tsx src/web/server.ts",

{
  "name": "department-os",
  "version": "0.0.0",
  "private": true,
  "description": "Department OS Core — Problem Department MVP implementation",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/web/server.ts",
    "dev:client": "vite --config src/client/vite.config.ts",
    "start": "node --import tsx src/web/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "build": "vite build --config src/client/vite.config.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
